{
  "name": "practical-data",
  "version": "1.2.0",
  "description": "Chrome extension that color-encodes comparable columns in HTML tables using a System One decision model.",
  "license": "MIT",
  "author": "Phil Renaud",
  "repository": {
    "type": "git",
    "url": "https://github.com/philrenaud/practical-data.git"
  },
  "homepage": "https://practicaldata.dev",
  "config": {
    "storeUrl": "https://chromewebstore.google.com/detail/practical-data/oeoogiokpnkhimnepeepflkpmghiokgm"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch --dev",
    "build:dev": "node scripts/build.ts --dev",
    "flags": "node scripts/flags.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "snapshot": "node scripts/snapshot.ts",
    "eval": "node scripts/eval.ts",
    "e2e": "node scripts/e2e.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run eval -- --offline --strict && npm run e2e -- --offline",
    "demo": "npm run build && npm run demo:data && npm run tests:data && node scripts/build-demo.ts",
    "web:dev": "npm run demo:data && npm run tests:data && npm run dev -w web",
    "web:check": "npm run check -w web",
    "deploy": "npm run demo && wrangler deploy",
    "package": "node scripts/package.ts",
    "api:dev": "wrangler dev -c api/wrangler.jsonc",
    "api:smoke": "node scripts/api-smoke.ts",
    "api:usage": "node scripts/api-usage.ts",
    "api:deploy": "wrangler deploy -c api/wrangler.jsonc",
    "demo:data": "node scripts/demo-data.ts",
    "tests:data": "node scripts/tests-data.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "d3-color": "3.1.0",
    "d3-interpolate": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-scale-chromatic": "3.1.0",
    "d3-selection": "3.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/d3-color": "3.1.3",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/d3-selection": "3.0.12",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  },
  "workspaces": [
    "web"
  ]
}
