{
  "name": "practical-data",
  "version": "1.0.0",
  "description": "Chrome extension that color-encodes comparable columns in HTML tables using a System One decision model.",
  "license": "MIT",
  "author": "Phil Renaud",
  "repository": {
    "type": "git",
    "url": "https://github.com/philrenaud/practical-data.git"
  },
  "homepage": "https://practicaldata.dev",
  "config": {
    "storeUrl": ""
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "snapshot": "node scripts/snapshot.ts",
    "eval": "node scripts/eval.ts",
    "e2e": "node scripts/e2e.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run eval -- --offline --strict && npm run e2e -- --offline",
    "demo": "npm run build && node scripts/demo-data.ts && node scripts/build-demo.ts",
    "deploy": "npm run demo && npx wrangler@4.147.0 deploy",
    "package": "node scripts/package.ts",
    "publish:store": "node scripts/publish-store.ts"
  },
  "dependencies": {
    "d3-color": "3.1.0",
    "d3-interpolate": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-scale-chromatic": "3.1.0",
    "d3-selection": "3.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/d3-color": "3.1.3",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/d3-selection": "3.0.12",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
