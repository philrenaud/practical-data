{
  "extends": "$app/tsconfig",
  "include": ["src", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  }
}
